# ==============================================================
# VisionGuard AI - Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================

# Application Metadata
APP_NAME=VisionGuard AI
APP_ENV=production
DEBUG=False
LOG_LEVEL=info

# Server Networking
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration (SQLite default / PostgreSQL compatible)
# Examples:
#   SQLite: sqlite:///./visionguard.db
#   PostgreSQL: postgresql://user:password@localhost:5432/visionguard_db
DATABASE_URL=sqlite:///./visionguard.db

# Storage Directories
MODELS_DIR=app/models_storage
DATASET_DIR=app/dataset/data_root

# Computer Vision & Hardware Accelerator (cpu, cuda, or auto)
DEVICE=cpu
YOLO_MODEL_PATH=app/models_storage/yolov8_defect.pt
ANOMALY_MODEL_PATH=app/models_storage/anomaly_model.pt

# Quality Inspection & Thresholding Defaults
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
DEFAULT_HEATMAP_ALPHA=0.45
ANOMALY_THRESHOLD=0.2532

# CORS & Security (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Client
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173
